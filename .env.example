# --- Database (docker compose) ---
POSTGRES_USER=paperflow
POSTGRES_PASSWORD=paperflow_dev
POSTGRES_DB=paperflow
POSTGRES_PORT=5432

# --- Backend ---
# Async/sync SQLAlchemy URL used by the API.
DATABASE_URL=postgresql+psycopg://paperflow:paperflow_dev@localhost:5432/paperflow
PAPERFLOW_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173

# Where uploaded assets and generated PDFs are stored.
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=15

# Playwright export controls
PDF_EXPORT_TIMEOUT_MS=45000
